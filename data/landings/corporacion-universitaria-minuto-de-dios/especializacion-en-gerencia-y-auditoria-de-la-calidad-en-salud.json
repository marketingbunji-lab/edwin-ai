ld.value = PROGRAM_NAME;\n\n    if (programField.tagName === 'SELECT') {\n      const option = Array.from(programField.options || []).find((item) => item.value === PROGRAM_NAME);\n      if (option) {\n        option.selected = true;\n      }\n    }\n\n    hideField(programField);\n  }\n\n  function configureMainForm() {\n    const form = document.querySelector('#conversion-form-ms-innovaciones-pastorales');\n    if (!form) return false;\n\n    const consent = form.querySelector(\"input[name='privacy_data[consent]']\");\n    if (consent) consent.checked = true;\n\n    const origenField = form.querySelector('[name=\"cf_origen\"]');\n    if (origenField) {\n      origenField.value = 'google';\n      hideField(origenField);\n    }\n\n    replaceInputWithSelect('cf_canales_de_contactabilidad', [\n      { value: 'WhatsApp', label: 'WhatsApp' },\n      { value: 'Llamada', label: 'Llamada' },\n      { value: 'Correo', label: 'Correo' },\n    ]);\n\n    replaceInputWithSelect('cf_horario_preferido_para_contacto', [\n      { value: '7_am_a_12_pm', label: '7_am_a_12_pm' },\n      { value: 'de_12_pm_a_2_pm', label: 'de_12_pm_a_2_pm' },\n      { value: 'de_2_pm_a_6_pm', label: 'de_2_pm_a_6_pm' },\n      { value: 'de_6_pm_a_8_pm', label: 'de_6_pm_a_8_pm' },\n    ]);\n\n    replaceInputWithSelect('cf_tu_ciudad', [\n      { value: '', label: 'Selecciona tu ciudad', disabled: true },\n      { value: 'Bogot\\u00e1 D.C.', label: 'Bogot\\u00e1 D.C.' },\n      { value: 'Soacha', label: 'Soacha' },\n      { value: 'Zipaquir\\u00e1', label: 'Zipaquir\\u00e1' },\n      { value: 'Medell\\u00edn', label: 'Medell\\u00edn' },\n      { value: 'Bello', label: 'Bello' },\n      { value: 'Envigado', label: 'Envigado' },\n      { value: 'Itag\\u00fc\\u00ed', label: 'Itag\\u00fc\\u00ed' },\n      { value: 'Rionegro', label: 'Rionegro' },\n      { value: 'Barranquilla', label: 'Barranquilla' },\n      { value: 'Soledad', label: 'Soledad' },\n      { value: 'Malambo', label: 'Malambo' },\n      { value: 'Bucaramanga', label: 'Bucaramanga' },\n      { value: 'Floridablanca', label: 'Floridablanca' },\n      { value: 'Barrancabermeja', label: 'Barrancabermeja' },\n      { value: 'Cali', label: 'Cali' },\n      { value: 'Palmira', label: 'Palmira' },\n      { value: 'Buenaventura', label: 'Buenaventura' },\n      { value: 'Otra', label: 'Otra' },\n    ]);\n\n    const documentInput = form.querySelector('input[name=\"cf_numero_de_documento\"]');\n    if (documentInput) {\n      documentInput.setAttribute('maxlength', '10');\n      const parentDiv = documentInput.parentElement;\n      if (parentDiv) {\n        parentDiv.style.width = '100%';\n      }\n    }\n\n    const mobilePhoneInput = form.querySelector('input[name=\"mobile_phone\"]');\n    if (mobilePhoneInput) {\n      mobilePhoneInput.setAttribute('maxlength', '15');\n      mobilePhoneInput.style.width = '100%';\n    }\n\n    applyProgramValue(form);\n\n    if (form.dataset.analyticsBound !== 'true') {\n      form.addEventListener('submit', function () {\n        if (!form.checkValidity()) {\n          form.reportValidity();\n          return;\n        }\n\n        const formData = new FormData(form);\n        const data = {\n          name: formData.get('cf_nombre_completo')?.trim() ?? '',\n          phone: formData.get('mobile_phone')?.trim() ?? '',\n          email: formData.get('email')?.trim() ?? '',\n          documentType: formData.get('cf_tu_tipo_de_documento')?.trim() ?? '',\n          documento: formData.get('cf_numero_de_documento')?.trim() ?? '',\n          program: formData.get('cf_programas')?.trim() ?? '',\n        };\n\n        if (!data.name || !data.phone || !data.email || !data.documentType || !data.documento || !data.program) {\n          return;\n        }\n\n        window.dataLayer = window.dataLayer || [];\n        window.dataLayer.push({\n          event: 'formSubmission',\n          nombre: data.name,\n          telefono: data.phone,\n          email: data.email,\n          tipodoc: d