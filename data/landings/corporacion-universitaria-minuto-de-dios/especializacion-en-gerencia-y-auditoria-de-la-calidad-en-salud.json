as')?.trim() ?? '',\n        formacion: formDataWa.get('cf_nivel_de_formacion_de_interes')?.trim() ?? '',\n      };\n\n      if (!dataWa.fullname || !dataWa.phone || !dataWa.email || !dataWa.documento || !dataWa.program || !dataWa.formacion) {\n        return;\n      }\n\n      window.dataLayer = window.dataLayer || [];\n      window.dataLayer.push({\n        event: 'formWhatsapp',\n        nombre: dataWa.fullname,\n        telefono: dataWa.phone,\n        email: dataWa.email,\n        documento: dataWa.documento,\n        programa: dataWa.program,\n        formacion: dataWa.formacion,\n      });\n    });\n\n    formPopup.dataset.listenerAdded = 'true';\n    return true;\n  }\n\n  fetch('https://api64.ipify.org?format=json')\n    .then((response) => response.json())\n    .then((data) => {\n      userIP = data.ip;\n      return fetch(`https://ipinfo.io/${userIP}/json`);\n    })\n    .then((response) => response.json())\n    .then((data) => {\n      countryIP = data.country;\n      stateIP = data.region;\n      ciudadIP = data.city;\n      ispIP = data.org;\n      postalCode = data.postal;\n    })\n    .catch((error) => console.error('Error obteniendo la informaci\\u00f3n:', error));\n\n  document.addEventListener('DOMContentLoaded', function () {\n    const interval = setInterval(() => {\n      const hasMainForm = configureMainForm();\n      const hasPopupForm = configurePopupForm();\n      if (hasMainForm || hasPopupForm) {\n        clearInterval(interval);\n      }\n    }, 100);\n\n    document.querySelectorAll('.back-to-top').forEach(function (btn) {\n      btn.addEventListener('click', function () {\n        window.dataLayer = window.dataLayer || [];\n        window.dataLayer.push({ event: 'botonAncla' });\n      });\n    });\n  });\n</script>",
