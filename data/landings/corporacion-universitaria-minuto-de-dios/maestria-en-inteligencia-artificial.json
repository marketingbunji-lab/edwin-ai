ld.value = PROGRAM_NAME;\n\n    if (programField.tagName === 'SELECT') {\n      const option = Array.from(programField.options || []).find((item) => item.value === PROGRAM_NAME);\n      if (option) {\n        option.selected = true;\n      }\n    }\n\n    hideField(programField);\n  }\n\n  function configureMainForm() {\n    const form = document.querySelector('#conversion-form-ms-innovaciones-pastorales');\n    if (!form) return false;\n\n    const consent = form.querySelector(\"input[name='privacy_data[consent]']\");\n    if (consent) consent.checked = true;\n\n    const origenField = form.querySelector('[name=\"cf_origen\"]');\n    if (origenField) {\n      origenField.value = 'google';\n      hideField(origenField);\n    }\n\n    replaceInputWithSelect('cf_canales_de_contactabilidad', [\n      { value: 'WhatsApp', label: 'WhatsApp' },\n      { value: 'Llamada', label: 'Llamada' },\n      { value: 'Correo', label: 'Correo' },\n    ]);\n\n    replaceInputWithSelect('cf_horario_preferido_para_contacto', [\n      { value: '7_am_a_12_pm', label: '7_am_a_12_pm' },\n      { value: 'de_12_pm_a_2_pm', label: 'de_12_pm_a_2_pm' },\n      { value: 'de_2_pm_a_6_pm', label: 'de_2_pm_a_6_pm' },\n      { value: 'de_6_pm_a_8_pm', label: 'de_6_pm_a_8_pm' },\n    ]);\n\n    replaceInputWithSelect('cf_tu_ciudad', [\n      { value: '', label: 'Selecciona tu ciudad', disabled: true },\n      { value: 'Bogot\\u00e1 D.C.', label: 'Bogot\\u00e1 D.C.' },\n      { value: 'Soacha', label: 'Soacha' },\n      { value: 'Zipaquir\\u00e1', label: 'Zipaquir\\u00e1' },\n      { value: 'Medell\\u00edn', label: 'Medell\\u00edn' },\n      { value: 'Bello', label: 'Bello' },\n      { value: 'Envigado', label: 'Envigado' },\n      { value: 'Itag\\u00fc\\u00ed', label: 'Itag\\u00fc\\u00ed' },\n      { value: 'Rionegro', label: 'Rionegro' },\n      { value: 'Barranquilla', label: 'Barranquilla' },\n      { value: 'Soledad', label: 'Soledad' },\n      { value: 'Malambo', label: 'Malambo' },\n      { value: 'Bucaramanga', label: 'Bucaramanga' },\n      { value: 'Floridablanca', label: 'Floridablanca' },\n      { value: 'Barrancabermeja', label: 'Barrancabermeja' },\n      { value: 'Cali', label: 'Cali' },\n      { value: 'Palmira', label: 'Palmira' },\n      { value: 'Buenaventura', label: 'Buenaventura' },\n      { value: 'Otra', label: 'Otra' },\n    ]);\n\n    const documentInput = form.querySelector('input[name=\"cf_numero_de_documento\"]');\n    if (documentInput) {\n      documentInput.setAttribute('maxlength', '10');\n      const parentDiv = documentInput.parentElement;\n      if (parentDiv) {\n        parentDiv.style.width = '100%';\n      }\n    }\n\n    const mobilePhoneInput = form.querySelector('input[name=\"mobile_phone\"]');\n    if (mobilePhoneInput) {\n      mobilePhoneInput.setAttribute('maxlength', '15');\n      mobilePhoneInput.style.width = '100%';\n    }\n\n    applyProgramValue(form);\n\n    if (form.dataset.analyticsBound !== 'true') {\n      form.addEventListener('submit', function () {\n        if (!form.checkValidity()) {\n          form.reportValidity();\n          return;\n        }\n\n        const formData = new FormData(form);\n        const data = {\n          name: formData.get('cf_nombre_completo')?.trim() ?? '',\n          phone: formData.get('mobile_phone')?.trim() ?? '',\n          email: formData.get('email')?.trim() ?? '',\n          documentType: formData.get('cf_tu_tipo_de_documento')?.trim() ?? '',\n          documento: formData.get('cf_numero_de_documento')?.trim() ?? '',\n          program: formData.get('cf_programas')?.trim() ?? '',\n        };\n\n        if (!data.name || !data.phone || !data.email || !data.documentType || !data.documento || !data.program) {\n          return;\n        }\n\n        window.dataLayer = window.dataLayer || [];\n        window.dataLayer.push({\n          event: 'formSubmission',\n          nombre: data.name,\n          telefono: data.phone,\n          email: data.email,\n          tipodoc: data.documentType,\n          documento: data.documento,\n          programa: data.program,\n          utm_campaign: utmParams?.utm_campaign ?? '',\n          utm_content: utmParams?.utm_content ?? '',\n          utm_device: utmParams?.utm_device ?? '',\n          utm_matchtype: utmParams?.utm_matchtype ?? '',\n          utm_medium: utmParams?.utm_medium ?? '',\n          utm_source: utmParams?.utm_source ?? '',\n          utm_term: utmParams?.utm_term ?? '',\n          Code_Id: utmParams?.Code_Id ?? '',\n          adposition: utmParams?.adposition ?? '',\n          creative_id: utmParams?.creative_id ?? '',\n          network: utmParams?.network ?? '',\n          formIp: userIP ?? '',\n          formNavegador: userAgent ?? '',\n          formCountryIP: countryIP ?? '',\n          formStateIP: stateIP ?? '',\n          formCiudadIP: ciudadIP ?? '',\n          formIspIP: ispIP ?? '',\n          formPostalCode: postalCode ?? '',\n        });\n      });\n\n      form.dataset.analyticsBound = 'true';\n    }\n\n    return true;\n  }\n\n  function configurePopupForm() {\n    const formPopup = document.querySelector('.rdstation-popup-js-form-identifier');\n    if (!formPopup) return false;\n\n    const consent = formPopup.querySelector(\"input[name='privacy_data[consent]']\");\n    if (consent) consent.checked = true;\n\n    applyProgramValue(formPopup);\n\n    if (formPopup.dataset.listenerAdded === 'true') {\n      return true;\n    }\n\n    formPopup.addEventListener('submit', function () {\n      if (!formPopup.checkValidity()) {\n        formPopup.reportValidity();\n        return;\n      }\n\n      const formDataWa = new FormData(formPopup);\n      const dataWa = {\n        fullname: formDataWa.get('cf_nombre_completo')?.trim() ?? '',\n        phone: formDataWa.get('mobile_phone')?.trim() ?? '',\n        email: formDataWa.get('email')?.trim() ?? '',\n        documento: formDataWa.get('cf_numero_de_documento')?.trim() ?? '',\n        program: formDataWa.get('cf_programas')?.trim() ?? '',\n        formacion: formDataWa.get('cf_nivel_de_formacion_de_interes')?.trim() ?? '',\n      };\n\n      if (!dataWa.fullname || !dataWa.phone || !dataWa.email || !dataWa.documento || !dataWa.program || !dataWa.formacion) {\n        return;\n      }\n\n      window.dataLayer = window.dataLayer || [];\n      window.dataLayer.push({\n        event: 'formWhatsapp',\n        nombre: dataWa.fullname,\n        telefono: dataWa.phone,\n        email: dataWa.email,\n        documento: dataWa.documento,\n        programa: dataWa.program,\n        formacion: dataWa.formacion,\n      });\n    });\n\n    formPopup.dataset.listenerAdded = 'true';\n    return true;\n  }\n\n  fetch('https://api64.ipify.org?format=json')\n    .then((response) => response.json())\n    .then((data) => {\n      userIP = data.ip;\n      return fetch(`https://ipinfo.io/${userIP}/json`);\n    })\n    .then((response) => response.json())\n    .then((data) => {\n      countryIP = data.country;\n      stateIP = data.region;\n      ciudadIP = data.city;\n      ispIP = data.org;\n      postalCode = data.postal;\n    })\n    .catch((error) => console.error('Error obteniendo la informaci\\u00f3n:', error));\n\n  document.addEventListener('DOMContentLoaded', function () {\n    const interval = setInterval(() => {\n      const hasMainForm = configureMainForm();\n      const hasPopupForm = configurePopupForm();\n      if (hasMainForm || hasPopupForm) {\n        clearInterval(interval);\n      }\n    }, 100);\n\n    document.querySelectorAll('.back-to-top').forEach(function (btn) {\n      btn.addEventListener('click', function () {\n        window.dataLayer = window.dataLayer || [];\n        window.dataLayer.push({ event: 'botonAncla' });\n      });\n    });\n  });\n</script>",
