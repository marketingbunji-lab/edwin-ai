  "overview": {
    "eyebrow": "",
    "title": "Presentación del programa",
    "description": "El programa de Licenciatura en Diseño Tecnológico forma docentes innovadores capaces de transformar los entornos educativos mediante la integración de pedagogía, tecnología y diseño. Su propuesta académica fortalece la investigación, la inclusión y el uso estratégico de tecnologías para responder a los desafíos de la educación actual y futura, promoviendo experiencias de aprendizaje dinámicas, humanas y de alta calidad.",
    "image": "https://www.uniminuto.edu/sites/default/files/styles/scale_and_crop_640x640/public/2026-07/Licenciatura%20en%20Dise%C3%B1o%20Tecnol%C3%B3gico%202_0.png?itok=3i4DRip0",
    "items": []
  },
  "graduateProfile": {
    "eyebrow": "",
    "title": "Perfil del egresado",
    "image": "",
    "items": [
      {
        "title": "",
        "description": "Estructurar los conocimientos pedagógicos y tecnológicos en el diseño educativo a partir del análisis en la planificación e innovación de los procesos de enseñanza y aprendizaje, para la toma de decisiones en la mejora de las prácticas educativas.",
        "url": "",
        "image": "",
        "items": []
      },
      {
        "title": "",
        "description": "Diseñar propuestas de intervención pedagógica fundamentadas en el uso de tecnologías a partir de la integración de estrategias innovadoras para la gestión y transformación de los procesos de enseñanza y aprendizaje en entornos educativos dinámicos, efectivos e inclusivos.",
        "url": "",
        "image": "",
        "items": []
      },
      {
        "title": "",
        "description": "Explicar el desarrollo del área de Tecnología e Informática en el sistema educativo y su relación con otras áreas del conocimiento a partir del liderazgo pedagógico basado en la investigación formativa para el fortalecimiento de las habilidades del siglo XXI en las comunidades educativas.",
        "url": "",
        "image": "",
        "items": []
      }
    ]
  },
